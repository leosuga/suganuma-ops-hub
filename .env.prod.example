# Suganuma Ops Hub — variáveis de ambiente de produção
# Copie para .env.prod e preencha os valores reais.
# NUNCA commite .env.prod no repositório.

# ── Supabase ──────────────────────────────────────────────
# Encontre em: Supabase Studio → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://api.suganuma.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key do Supabase Studio>

# Service role key — usada apenas pelo servidor (agent API).
# Encontre em: Supabase Studio → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=<service_role key do Supabase Studio>

# ── Webhooks ──────────────────────────────────────────────
# Cada webhook tem seu próprio secret HMAC-SHA256 para isolamento de blast radius.
# Gere com: openssl rand -hex 32
#
# LEGADO: WEBHOOK_SECRET ainda é usado como fallback se os específicos não estiverem setados.
# Recomendado: definir os 3 específicos e remover WEBHOOK_SECRET.
WEBHOOK_SECRET=<legado — manter enquanto não definir os específicos>

# Email → Task webhook (/api/webhooks/email-to-task)
EMAIL_SECRET=<openssl rand -hex 32>

# CSV import webhook (/api/webhooks/csv-from-bank)
CSV_SECRET=<openssl rand -hex 32>

# Deploy status webhook (/api/webhooks/deploy-status)
DEPLOY_SECRET=<openssl rand -hex 32>
